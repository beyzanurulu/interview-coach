# --- Backend (services/api) ---
APP_ENV=development
LOG_LEVEL=INFO
# Virgülle ayrılmış adres listesi
CORS_ORIGINS=http://localhost:3000

# LLM (ADR-002). LLM_PROVIDER: groq | ollama (ollama sadece yerel geliştirme)
LLM_PROVIDER=groq
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# --- Frontend (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
